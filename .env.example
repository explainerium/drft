# Backend origin, server-only: rewrite target for /api/v1/* and server-side fetches.
# On Vercel: the backend project's URL (e.g. https://drft-api.vercel.app).
API_ORIGIN=http://localhost:5005
# Browser calls are same-origin through the rewrite.
NEXT_PUBLIC_API_URL=/api/v1
# On Vercel: the site domain (sitemap, robots, canonical and share URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Added as their features land — see PLAN.md §12:
# NEXT_PUBLIC_MEDIA_URL, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, NEXT_PUBLIC_PAYPAL_CLIENT_ID
